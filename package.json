{
  "name": "@ateliercartographie/ok-palette",
  "version": "0.3.0",
  "description": "Générateur de palettes de couleurs séquentielles, divergentes et catégorielles pour la dataviz et la cartographie",
  "type": "module",
  "main": "./dist/ok-palette.cjs",
  "module": "./dist/ok-palette.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/ok-palette.js",
      "require": "./dist/ok-palette.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite serve demo",
    "build": "tsc --noEmit && vite build && tsc --declaration --emitDeclarationOnly",
    "preview": "vite preview",
    "diagnose": "node scripts/diagnose-categorical.ts && node scripts/diagnose-ramps.ts",
    "diagnose:categorical": "node scripts/diagnose-categorical.ts",
    "diagnose:ramps": "node scripts/diagnose-ramps.ts",
    "diagnose:cmyk": "node scripts/diagnose-cmyk.ts",
    "build:cmyk-gamuts": "node scripts/build-cmyk-gamuts.ts",
    "build:cmyk-luts": "node scripts/build-cmyk-luts.ts",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "keywords": [
    "color",
    "palette",
    "dataviz",
    "cartography",
    "oklch",
    "sequential",
    "divergent",
    "categorical",
    "pattern",
    "motif"
  ],
  "author": "Atelier de cartographie de Sciences Po",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtelierCartographie/ok-palette"
  },
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@ateliercartographie/motif.js": "^0.1.4",
    "jscolorengine": "1.7.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
